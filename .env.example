# Copy to .env.local and fill in. The build fails at page-data collection
# without the Kinde vars, and Convex queries no-op without the Convex URL.

# ── Convex ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=

# ── Kinde auth ────────────────────────────────────────────────────────────────
KINDE_ISSUER_URL=https://devrelstudio.kinde.com
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard

# ── Manager access codes ──────────────────────────────────────────────────────
# Server-side pepper for hashing client dashboard access codes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every existing access code.
MANAGER_CODE_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
# Root domain used to build client dashboard links, e.g. devrel.studio
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Absolute origin, used for Stripe's return URLs (which cannot be relative).
# Falls back to KINDE_SITE_URL, then the request origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stat auto-sync (convex/sync.ts) ───────────────────────────────────────────
# Set on the CONVEX deployment (npx convex env set), not in .env.local.
#
# Optional. npm needs no credentials; GitHub allows 60 requests/hour per IP
# unauthenticated, which is fine for the daily cron but tight for repeated
# manual refreshes. A read-only token with no scopes raises it to 5,000/hour.
GITHUB_TOKEN=

# ── Transactional email (convex/email.ts) ─────────────────────────────────────
# Set on the CONVEX deployment (npx convex env set), not in .env.local — the
# senders run inside Convex actions:
#   npx convex env set RESEND_API_KEY re_...
#   npx convex env set EMAIL_FROM "DevRel Studio <hello@devrel.studio>"
#   npx convex env set SITE_URL https://devrel.studio
#
# Optional. Without RESEND_API_KEY nothing is sent: each send logs the message it
# would have delivered and reports `not-configured`, so waitlist signups and
# invitations still succeed. Workspace invitations always return a link the owner
# can share by hand, so email is a convenience rather than a hard dependency.
#
# SITE_URL is how Convex builds absolute links (invitation URLs). It is separate
# from NEXT_PUBLIC_ROOT_DOMAIN because Convex cannot read the Next.js env.
RESEND_API_KEY=
EMAIL_FROM=
SITE_URL=

# ── Error monitoring (optional) ───────────────────────────────────────────────
# Without a DSN the Sentry SDK does not initialise at all, so local development
# and CI are unaffected. Set these in Vercel to start collecting.
#
# The digest shown on the error screen is what correlates a user's report with
# the captured event — without monitoring configured, that reference leads
# nowhere.
#
# Session replay is deliberately disabled in code: this app displays client
# revenue figures and content behind an access code.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ── Stripe billing ────────────────────────────────────────────────────────────
# Billing is optional: without these the app runs and the billing page reports
# that checkout is unavailable rather than failing.
#
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET must ALSO be set on the Convex
# deployment, because the webhook is handled at <CONVEX_SITE_URL>/stripe:
#   npx convex env set STRIPE_SECRET_KEY sk_...
#   npx convex env set STRIPE_WEBHOOK_SECRET whsec_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# One-time payment Price IDs from the Stripe dashboard.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
